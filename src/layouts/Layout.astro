---
import "../styles/global.css";
import Header from "../components/Header.astro";
import LogoSayon from '../../public/logosayon.svg';
import {Image} from 'astro:assets';
---
<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/logosayon.svg" />
        <link rel="icon" href="/logosayon.ico" />
        <meta name="generator" content={Astro.generator} />
        <title>Sayon</title>
    </head>
    <body class="relative bg-fondos flex flex-col min-h-screen text-main ">
    <Header />

    <section class="relative z-10 w-full h-screen md:overflow-y-scroll scroll-smooth">
        <slot />
    </section>

    <div id="toast-default" class="fixed bottom-4 right-4 z-50 flex items-center w-full max-w-xs p-4 text-body bg-neutral-primary-soft rounded-base shadow-lg border border-default transition-all duration-300 opacity-0 translate-y-4 pointer-events-none" role="alert">
        <div class="inline-flex items-center justify-center shrink-0 w-7 h-7 text-fg-success bg-success-soft rounded">
            <Image loading="eager" src={LogoSayon} alt="Logo Sayon" class="size-8" />
            <span class="sr-only">Check icon</span>
        </div>
        <div class="ms-2.5 text-md border-s border-default ps-3.5">Muchas gracias por el interes, pero este es un proyecto educativo y no un producto comercial.</div>
        <button type="button" id="close-toast" class="cursor-pointer ms-auto flex items-center justify-center text-body hover:text-heading bg-transparent box-border border border-transparent hover:bg-neutral-secondary-medium focus:ring-4 focus:ring-neutral-tertiary font-medium leading-5 rounded text-sm h-8 w-8 focus:outline-none" data-dismiss-target="#toast-default" aria-label="Close">
            <span class="sr-only">Close</span>
            <svg class="w-5 h-5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18 17.94 6M18 18 6.06 6"/></svg>
        </button>
    </div>

    <script>
        // Handle toast logic
        const pricingButtons = document.querySelectorAll('.toast-btn');
        const toastDefault = document.getElementById('toast-default');
        const closeToast = document.getElementById('close-toast');
        let toastTimeout: any;

        pricingButtons.forEach(btn => {
            btn.addEventListener('click', (e) => {
                e.preventDefault();
                if (toastDefault) {
                    toastDefault.classList.remove('opacity-0', 'translate-y-4', 'pointer-events-none');
                    toastDefault.classList.add('opacity-100', 'translate-y-0');
                    
                    clearTimeout(toastTimeout);
                    toastTimeout = setTimeout(() => {
                        toastDefault.classList.add('opacity-0', 'translate-y-4', 'pointer-events-none');
                        toastDefault.classList.remove('opacity-100', 'translate-y-0');
                    }, 3000);
                }
            });
        });

        closeToast?.addEventListener('click', () => {
            if (toastDefault) {
                toastDefault.classList.add('opacity-0', 'translate-y-4', 'pointer-events-none');
                toastDefault.classList.remove('opacity-100', 'translate-y-0');
                clearTimeout(toastTimeout);
            }
        });
    </script>
</body>
</html>

<style>
    html,
    body {
        margin: 0;
        width: 100%;
        height: 100%;
    }
</style>