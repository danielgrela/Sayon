---
import "../styles/global.css";
import Header from "../components/Header.astro";
---
<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="generator" content={Astro.generator} />
        <title>Sayon</title>
    </head>
    <body class="relative bg-fondos flex flex-col min-h-screen">
    <Header />

    <section class="relative z-10 w-full h-full">
        <slot />
    </section>
</body>
</html>

<style>
    html,
    body {
        margin: 0;
        width: 100%;
        height: 100%;
    }
</style>