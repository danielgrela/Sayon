---
export interface Props {
  title: string;
  price: string;
  billingText?: string;
  description: string;
  features: (string | { name: string; included: boolean })[];
  buttonText: string;
  badge?: string;
}

const {
  title,
  price,
  billingText = "",
  description,
  features,
  buttonText,
  badge = "",
} = Astro.props;
---

<div class="relative flex flex-col p-8 rounded-2xl border bg-white border-gray-200 shadow-sm hover:shadow-xl transition-shadow duration-300 h-full">
  <div class="mb-4">
    <div class="flex items-center gap-2">
      <h3 class="text-xl font-medium">{title}</h3>
      {badge && (
        <span class="inline-flex items-center rounded-full bg-orange-100/80 px-2.5 py-0.5 text-[10px] font-semibold text-orange-700 uppercase tracking-wide">
          🔥 {badge}
        </span>
      )}
    </div>
    <div class="mt-5 flex items-baseline text-5xl font-medium tracking-tight">
      {price}
    </div>
      <p class="mt-2 text-xs text-gray-500">
        {billingText}
      </p>
  </div>

  <p class={`mt-4 text-sm font-medium`}>
    {description}
  </p>

  <ul role="list" class={`mt-6 space-y-4 flex-1 text-sm `}>
    {features.map((feature) => {
      const isString = typeof feature === 'string';
      const name = isString ? feature : feature.name;
      const included = isString ? true : feature.included;
      
      return (
        <li class={`flex items-center gap-3 ${included ? 'text-gray-900' : 'text-gray-500 line-through'}`}>
          {included ? (
            <svg class="h-4 w-4 shrink-0 rounded-md p-0.5 bg-green-100 text-green-600" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" />
            </svg>
          ) : (
            <svg class="h-4 w-4 shrink-0 rounded-md p-0.5 bg-gray-100 text-gray-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
          )}
          <span>{name}</span>
        </li>
      );
    })}
  </ul>

  <button class="cursor-pointer toast-btn mt-8 block rounded-xl px-3 py-3 text-center text-sm font-semibold transition-colors bg-botones text-fondos hover:brightness-80">
    {buttonText}
  </button>
</div>