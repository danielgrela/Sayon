---
import {Image} from 'astro:assets';
import LogoSayon from '../../public/logosayon.svg';
---
<header class="hidden lg:flex w-full z-20 flex-row items-center justify-between py-3 px-8 top-o right-0 left-0 fixed bg-fondos">
        <section class="flex flex-row items-center gap-8 xl:gap-14">
                <a href="/" class="flex flex-row gap-1 items-center">
                        <Image loading="eager" src={LogoSayon} alt="Logo Sayon" class="size-8" />
                        <h2 class="text-3xl font-bold text-main">Sayon</h2>
                </a>
                <ul class="flex flex-row gap-8 items-center text-xl">
                        <li><a href="#testimonials" class="hover:text-main/70 text-main font-bold transition-colors duration-200">Valoraciones</a></li>
                        <li><a href="#pricing" class="hover:text-main/70 text-main font-bold transition-colors duration-200">Precios</a></li>
                </ul>
        </section>
        <section class="flex flex-row gap-6">
                <a href="mailto:jcajal@ucm.es" class="uppercase text-md font-bold px-6 py-3 border-2 border-botones text-botones rounded-md hover:brightness-70 cursor-pointer transition-all duration-200">Contactar Soporte</a>
                <button class="toast-btn uppercase text-md font-semibold px-6 py-3 bg-botones text-fondos rounded-md hover:brightness-70 cursor-pointer transition-all duration-200 ">Probar Gratis</button>
        </section>
</header>