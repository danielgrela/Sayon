---
import PricingCard from '../components/PricingCard.astro';
---

<section class="relative flex flex-col justify-center md:pt-18 pb-8" id="pricing">
  <div class="relative z-10 mx-auto w-full px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="font-bold tracking-tight text-main text-3xl 2xl:text-5xl">Planes y Precios</h2>
      <p class="mt-4 text-base text-main/80">
        Recibe el mejor servicio pagando anualmente <br>y ahorra un 35% en tu suscripción.
      </p>
    </div>

    <div class="mt-8 flex justify-center">
      <div class="relative flex items-center p-1 rounded-full bg-gray-50/50 border border-gray-100 shadow-sm w-max">
        
        <div 
          id="toggle-slider" 
          class="absolute left-1 top-1 bottom-1 rounded-full bg-white shadow-sm border border-gray-100 transition-all duration-300 ease-in-out z-0"
        ></div>

        <button 
          id="btn-monthly" 
          type="button" 
          class="relative z-10 rounded-full py-2 px-8 text-sm font-medium text-gray-900 bg-transparent whitespace-nowrap transition-colors duration-300 cursor-pointer"
        >
          Mensual
        </button>

        <button 
          id="btn-annual" 
          type="button" 
          class="relative z-10 flex items-center justify-center gap-2 rounded-full py-2 px-6 text-sm font-medium text-gray-500 hover:text-gray-900 bg-transparent whitespace-nowrap transition-colors duration-300 cursor-pointer"
        >
          Anual 
          <span id="badge-anual" class="border border-transparent rounded-full bg-gray-100 px-2 py-0.5 text-[10px] uppercase font-semibold text-gray-600 tracking-wider">
            HASTA EL -50%
          </span>
        </button>
      </div>
    </div>

    <div class="mx-20 mt-16 grid gap-6 max-w-full grid-cols-[repeat(auto-fit,minmax(300px,1fr))] justify-center">
      
      <PricingCard
        title="Gratis"
        price="0€"
        billingText='Plan gratuito sin límite.'
        description="La experiencia básica."
        features={[
          { name: "Interfaz más simple", included: true },
          { name: "Hasta 100 llamadas al mes", included: true },
          { name: "Algunas funciones de accesibilidad", included: true },
          { name: "Configuración remota", included: false },
          { name: "Asistencia 24/7", included: false }
        ]}
        buttonText="Empezar gratuitamente"
      />

      <div id="plan-pro-monthly" class="block">
        <PricingCard
          title="Pro"
          price="5€" 
          billingText="Pago mensual por usuario"
          description="La experiencia completa para familias."
          features={[
            { name: "Interfaz más simple", included: true },
            { name: "Llamadas ilimitadas", included: true },
            { name: "Todas las funciones de accesibilidad", included: true },
            { name: "Hasta 3 familiares en configuración remota.", included: true },
            { name: "Asistencia 24/7", included: true }
          ]}
          buttonText="Empezar con Pro"
        />
      </div>

      <div id="plan-pro-annual" class="hidden">
        <PricingCard
          title="Pro"
          price="39€"
          billingText="Por usuario, cobrado anualmente"
          description="La experiencia completa para familias."
          badge="-35%"
          features={[
            { name: "Interfaz más simple", included: true },
            { name: "Llamadas ilimitadas", included: true },
            { name: "Todas las funciones de accesibilidad", included: true },
            { name: "Hasta 3 familiares en configuración remota.", included: true },
            { name: "Asistencia 24/7", included: true }
          ]}
          buttonText="Empezar con Pro"
        />
      </div>
      <div id="plan-familiar-monthly" class="block">
        <PricingCard
          title="Familiar"
          price="3€/usuario" 
          billingText="Pago mensual por usuario"
          badge="-40%"
          description="La experiencia completa para familias."
          features={[
            { name: "Interfaz más simple", included: true },
            { name: "Llamadas ilimitadas", included: true },
            { name: "Todas las funciones de accesibilidad", included: true },
            { name: "Hasta 3 familiares en configuración remota por usuario.", included: true },
            { name: "Asistencia 24/7", included: true }
          ]}
          buttonText="Empezar con Familiar"
        />
      </div>

      <div id="plan-familiar-annual" class="hidden">
        <PricingCard
          title="Familiar"
          price="30€/usuario"
          billingText="Por usuario, cobrado anualmente, mínimo de 2 usuarios."
          description="La experiencia completa para familias."
          badge="-50%"
          features={[
            { name: "Interfaz más simple", included: true },
            { name: "Llamadas ilimitadas", included: true },
            { name: "Todas las funciones de accesibilidad", included: true },
            { name: "Hasta 3 familiares en configuración remota por usuario.", included: true },
            { name: "Asistencia 24/7", included: true }
          ]}
          buttonText="Empezar con Familiar"
        />
      </div>

      <PricingCard
        title="Un solo pago"
        price="50€"
        billingText='Pago único por usuario.'
        description="Para quienes prefieren pagar una vez."
        badge='Mejor Oferta'
        features={[
          { name: "Interfaz más simple", included: true },
            { name: "Llamadas ilimitadas", included: true },
            { name: "Todas las funciones de accesibilidad", included: true },
            { name: "Hasta 5 familiares en configuración remota por usuario.", included: true },
            { name: "Asistencia 24/7", included: true }
        ]}
        buttonText="Pagar y olvidarme"
      />
      
    </div>
  </div>
</section>

<script>
  const btnMonthly = document.getElementById('btn-monthly');
  const btnAnnual = document.getElementById('btn-annual');
  const badgeanual = document.getElementById('badge-anual');
  const toggleSlider = document.getElementById('toggle-slider');
  
  const planProMonthly = document.getElementById('plan-pro-monthly');
  const planProAnnual = document.getElementById('plan-pro-annual');

  const planFamiliarMonthly = document.getElementById('plan-familiar-monthly');
  const planFamiliarAnnual = document.getElementById('plan-familiar-annual');
  function moveSlider(activeButton : HTMLElement | null) {
    if (!toggleSlider || !activeButton) return;
    
    const width = activeButton.offsetWidth;
    const offsetLeft = activeButton.offsetLeft;
    
    toggleSlider.style.width = `${width}px`;
    // Restamos 4px (el padding de 1rem que tiene el contenedor principal) para centrarlo perfecto
    toggleSlider.style.transform = `translateX(${offsetLeft - 4}px)`; 
  }

  setTimeout(() => {
    moveSlider(btnMonthly);
  }, 0);

  btnMonthly?.addEventListener('click', () => {
    moveSlider(btnMonthly);

    planProMonthly?.classList.remove('hidden');
    planProAnnual?.classList.add('hidden');
    planFamiliarMonthly?.classList.remove('hidden');
    planFamiliarAnnual?.classList.add('hidden');

    btnMonthly.classList.remove('text-gray-500');
    btnMonthly.classList.add('text-gray-900');
    btnAnnual?.classList.remove('text-gray-900');
    btnAnnual?.classList.add('text-gray-500');

    badgeanual?.classList.remove('text-orange-700', 'bg-orange-100/80', 'border-orange-300');
    badgeanual?.classList.add('border-transparent');
  });

  btnAnnual?.addEventListener('click', () => {
    moveSlider(btnAnnual);

    planProAnnual?.classList.remove('hidden');
    planProMonthly?.classList.add('hidden');
    planFamiliarAnnual?.classList.remove('hidden');
    planFamiliarMonthly?.classList.add('hidden');

    btnAnnual.classList.remove('text-gray-500');
    btnAnnual.classList.add('text-gray-900');
    btnMonthly?.classList.remove('text-gray-900');
    btnMonthly?.classList.add('text-gray-500');

    badgeanual?.classList.remove('border-transparent');
    badgeanual?.classList.add('text-orange-700', 'bg-orange-100/80', 'border-orange-300');
  });
</script>