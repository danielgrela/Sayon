---
interface Props {
  quote: string;
  name: string;
  title: string;
  imageId: number;
}

const { quote, name, title, imageId } = Astro.props;
---

<div class="w-95 shrink-0 bg-gray-50/60 rounded-3xl p-8 border border-gray-100 flex flex-col gap-4 shadow-sm hover:shadow-xl transition-shadow duration-300">
  <div class="text-blue-600 text-6xl font-serif leading-none h-8 mt-2">“</div>
  
  <p class="text-gray-800 text-[15px] font-medium leading-relaxed flex-1">
    {quote}
  </p>
  
  <div class="flex items-center gap-4 mt-6">
    <img 
      src={`https://i.pravatar.cc/150?img=${imageId}`} 
      alt={`Avatar de ${name}`} 
      class="w-12 h-12 rounded-full object-cover shadow-sm"
      loading="lazy"
    />
    <div class="flex flex-col">
      <h4 class="font-bold text-gray-900 text-sm">{name}</h4>
      <p class="text-xs text-gray-500 font-medium">{title}</p>
    </div>
  </div>
</div>